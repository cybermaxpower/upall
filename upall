#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Script Name:  upall
# Description:  Automated universal system updater for Linux. Automatically
#               detects the OS base (Debian/Ubuntu or Arch) via /etc/os-release
#               and safely handles APT, Pacman/AUR, Snap, and Flatpak updates.
# Author:       M. Wait (cybermaxpower) / https://github.com/cybermaxpower/upall
# License:      MIT License
# Version:      1.6.7
# Date:         2026-11-22
# ==============================================================================

VERSION="1.6.7"
FULL_UPGRADE=0
CLEAN_ONLY=0
DO_CLEAN=0
CLEAN_UPDATE=0
FULL_CLEAN=0

# ==========================================
# 0. PARSE COMMAND-LINE ARGUMENTS
# ==========================================
while (( $# > 0 )); do
    case "$1" in
        -v|--version)
            echo "upall version $VERSION"
            exit 0
            ;;
        -h|--help)
            cat << 'HELP'
Usage: upall [OPTION]

Automated universal system updater for Debian/Ubuntu and Arch-based Linux.

Options:
  -h, --help          Show this help message and exit
  -v, --version       Show version number and exit
  -a, --about         Show author, license, and repository details
  -f, --full          Use 'apt full-upgrade -y' on Debian/Ubuntu (no effect on Arch)
  -c, --clean         Clean APT orphans/cache (or paccache on Arch) and unused Flatpaks
  -u, --clean-update  Run updates first, then clean up old packages
      --full-clean    Perform a full APT upgrade followed by cleanup
HELP
            exit 0
            ;;
        -a|--about)
            cat << 'ABOUT'
upall - Universal Linux System Updater
Author:  M. Wait (cybermaxpower)
GitHub:  https://github.com/cybermaxpower/upall
License: MIT License
ABOUT
            exit 0
            ;;
        -f|--full)
            FULL_UPGRADE=1
            ;;
        -c|--clean)
            DO_CLEAN=1
            ;;
        -u|--clean-update)
            CLEAN_UPDATE=1
            DO_CLEAN=1
            ;;
        --full-clean)
            FULL_CLEAN=1
            FULL_UPGRADE=1
            DO_CLEAN=1
            ;;
        *)
            echo -e "\e[31m[ERROR]\e[0m Unknown option: $1"
            echo "Try 'upall --help' for more information."
            exit 1
            ;;
    esac
    shift
done

# Derive combined modes so --full --clean and --full --clean-update match --full-clean
if (( FULL_UPGRADE == 1 && DO_CLEAN == 1 )); then
    FULL_CLEAN=1
fi

# If --clean was passed on its own, run cleanup only
if (( DO_CLEAN == 1 && FULL_UPGRADE == 0 && CLEAN_UPDATE == 0 )); then
    CLEAN_ONLY=1
fi

# ==========================================
# 1. DETECT OPERATING SYSTEM / PACKAGER
# ==========================================
DISTRO_NAME="Linux"
PKG_MANAGER=""

if [[ -r /etc/os-release ]]; then
    DISTRO_NAME=$(. /etc/os-release && echo "${PRETTY_NAME:-${NAME:-Linux}}")
    OS_ID=$(. /etc/os-release && echo "${ID:-}")
    OS_LIKE=$(. /etc/os-release && echo "${ID_LIKE:-}")

    case " $OS_ID $OS_LIKE " in
        *" debian "*|*" ubuntu "*)
            PKG_MANAGER="apt"
            ;;
        *" arch "*|*" manjaro "*)
            PKG_MANAGER="pacman"
            ;;
    esac
fi

# Fallback to binary detection if /etc/os-release didn't match a known family
if [[ -z "$PKG_MANAGER" ]]; then
    if command -v apt >/dev/null 2>&1; then
        PKG_MANAGER="apt"
    elif command -v pacman >/dev/null 2>&1; then
        PKG_MANAGER="pacman"
    else
        echo -e "\e[31m[CRITICAL ERROR]\e[0m No supported package manager found for $DISTRO_NAME."
        echo -e "This script is not compatible with your operating system. Exiting safely."
        exit 1
    fi
fi

# ==========================================
# LOCK CHECK FUNCTION
# ==========================================
# Checks if the package database is locked by another process and retries
wait_for_lock() {
    local max_attempts=12
    local attempt=1
    local lock_detected=0

    while (( attempt <= max_attempts )); do
        lock_detected=0

        if [[ "$PKG_MANAGER" == "apt" ]]; then
            if sudo fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
               sudo fuser /var/lib/apt/lists/lock >/dev/null 2>&1; then
                lock_detected=1
            fi
        elif [[ "$PKG_MANAGER" == "pacman" ]]; then
            if [[ -f /var/lib/pacman/db.lck ]]; then
                lock_detected=1
            fi
        fi

        if (( lock_detected == 0 )); then
            return 0
        fi

        echo -e "\e[33m[WAIT]\e[0m Package manager is locked by another process. Retrying ($attempt/$max_attempts) in 5s..."
        sleep 5

        attempt=$((attempt + 1))
    done

    echo -e "\e[31m[ERROR]\e[0m Timed out waiting for package manager lock to be released."
    exit 1
}

# ==========================================
# 2. PRIVILEGE ELEVATION & SCREEN INIT
# ==========================================
clear

echo -e "\e[34m[INIT]\e[0m Requesting administrative privileges..."
sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

clear

# ==========================================
# 3. SYSTEM UPDATES / CLEANUP
# ==========================================
echo -e "╔═════════════════════════════════════════════════════╗"
if (( CLEAN_ONLY == 1 )); then
    echo -e "║               \e[34mStarting System Cleanup...\e[0m            ║"
elif (( FULL_CLEAN == 1 )); then
    echo -e "║         \e[32mStarting Full Upgrade & Cleanup...\e[0m          ║"
elif (( CLEAN_UPDATE == 1 )); then
    echo -e "║          \e[32mStarting Update & Cleanup...\e[0m              ║"
else
    echo -e "║          \e[32mStarting Full System Update...\e[0m             ║"
fi
echo -e "╚═════════════════════════════════════════════════════╝"
echo -e "\n"

echo -e "\e[32m[DETECTED]\e[0m $DISTRO_NAME ($PKG_MANAGER)"

wait_for_lock

if [[ "$PKG_MANAGER" == "apt" ]]; then
    if (( CLEAN_ONLY == 0 )); then
        if (( FULL_UPGRADE == 1 )); then
            echo -e "\e[33m[MODE]\e[0m Running full distribution upgrade (apt full-upgrade)..."
            sudo apt update && sudo apt full-upgrade -y
        else
            sudo apt update && sudo apt upgrade -y
        fi
    fi

    if (( DO_CLEAN == 1 )); then
        echo -e "\e[34m[MAINTENANCE]\e[0m Cleaning up orphaned APT packages and package cache..."
        sudo apt autoremove -y && sudo apt clean
    fi

elif [[ "$PKG_MANAGER" == "pacman" ]]; then
    if (( CLEAN_ONLY == 0 )); then
        if command -v yay >/dev/null 2>&1; then
            echo -e "\e[34m[AUR]\e[0m Updating with yay..."
            yay -Syu --noconfirm --answerdiff None --answeredit None
        elif command -v paru >/dev/null 2>&1; then
            echo -e "\e[34m[AUR]\e[0m Updating with paru..."
            paru -Syu --noconfirm --fm=no
        else
            sudo pacman -Syu --noconfirm
        fi
    fi

    if (( DO_CLEAN == 1 )); then
        if command -v paccache >/dev/null 2>&1; then
            echo -e "\e[34m[MAINTENANCE]\e[0m Trimming old Pacman package cache with paccache..."
            sudo paccache -r || echo -e "\e[33m[WARN]\e[0m paccache encountered an issue."
        else
            echo -e "\e[33m[WARN]\e[0m 'paccache' not found (install pacman-contrib for gentle cache cleanup)."
        fi
    fi
fi

echo -e "\n"

# ==========================================
# 4. SNAP UPDATES (Conditional & Silent)
# ==========================================
if (( CLEAN_ONLY == 0 )) && command -v snap >/dev/null 2>&1 && systemctl is-active --quiet snapd; then
    echo -e "╔═════════════════════════════════════════════════════╗"
    echo -e "║                 \e[34mRefreshing Snaps...\e[0m                 ║"
    echo -e "╚═════════════════════════════════════════════════════╝"
    echo -e "\n"

    sudo snap refresh
    echo -e "\n"
fi

# ==========================================
# 5. FLATPAK UPDATES & CLEANUP (Conditional)
# ==========================================
if command -v flatpak >/dev/null 2>&1; then
    echo -e "╔═════════════════════════════════════════════════════╗"
    if (( CLEAN_ONLY == 1 )); then
        echo -e "║               \e[35mCleaning Unused Flatpaks...\e[0m           ║"
    else
        echo -e "║                \e[35mUpdating Flatpaks...\e[0m                 ║"
    fi
    echo -e "╚═════════════════════════════════════════════════════╝"
    echo -e "\n"

    if (( CLEAN_ONLY == 0 )); then
        # Updates all Flatpaks, filtering unwanted informational messages.
        set +e
        if command -v col >/dev/null 2>&1; then
            flatpak update -y 2>&1 | col -b | grep -vE "end-of-life|receiving fixes|applications using|extension:|recommend moving"
        else
            flatpak update -y 2>&1 | grep -vE "end-of-life|receiving fixes|applications using|extension:|recommend moving"
        fi
        pipeline_status=("${PIPESTATUS[@]}")
        set -e

        # Check whether Flatpak itself failed.
        if [[ ${pipeline_status[0]} -ne 0 ]]; then
            echo -e "\e[31m[ERROR]\e[0m Flatpak updates failed!"
            exit 1
        fi
    fi

    if (( DO_CLEAN == 1 )); then
        echo -e "\e[34m[MAINTENANCE]\e[0m Removing unused Flatpak runtimes and libraries..."
        flatpak uninstall --unused -y || echo -e "\e[33m[WARN]\e[0m Flatpak cleanup skipped or encountered an issue."
    fi

    echo -e "\n"
fi

# ==========================================
# 6. FINISH
# ==========================================
if command -v notify-send >/dev/null 2>&1; then
    if (( CLEAN_ONLY == 1 )); then
        notify-send "System Cleanup Complete" "Package cleanup finished successfully!" --icon=system-software-update 2>/dev/null || true
    else
        notify-send "System Update Complete" "System updates finished successfully!" --icon=system-software-update 2>/dev/null || true
    fi
fi

echo -e "╔═════════════════════════════════════════════════════╗"
if (( CLEAN_ONLY == 1 )); then
    echo -e "║              \e[32mSYSTEM CLEANUP COMPLETE!\e[0m               ║"
elif (( FULL_CLEAN == 1 )); then
    echo -e "║          \e[32mFULL UPGRADE & CLEANUP COMPLETE!\e[0m           ║"
elif (( CLEAN_UPDATE == 1 )); then
    echo -e "║            \e[32mUPDATE & CLEANUP COMPLETE!\e[0m               ║"
else
    echo -e "║               \e[32mALL UPDATES COMPLETE!\e[0m                 ║"
fi
echo -e "╚═════════════════════════════════════════════════════╝"
echo -e "\n"
